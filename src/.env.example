# =======================================================================
# LIVEKIT CORE CONFIGURATION
# =======================================================================
# Find these in your LiveKit Cloud Dashboard (Project Settings > API Keys)
LIVEKIT_URL=wss://your-project-id.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# =======================================================================
# SIP TRUNK / VOBIZ CONFIGURATION
# =======================================================================
# Credentials provided by your SIP trunk provider (Vobiz)
VOBIZ_SIP_DOMAIN=sip.vobiz.com
VOBIZ_USERNAME=your_sip_username
VOBIZ_PASSWORD=your_sip_password
VOBIZ_OUTBOUND_NUMBER=+1234567890

# The Trunk ID generated after running `python manage_sip.py create`
# Starts with "ST_..."
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxx
SIP_TRUNK_ID=ST_xxxxxxxxxxxxx

# =======================================================================
# LLM (BRAIN) CONFIGURATION
# =======================================================================
# Allowed values: openai, groq (Defaults to openai if left blank)
LLM_PROVIDER=openai

# OpenAI API Key (Required if using OpenAI for LLM or TTS)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq Settings (Only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama3-8b-8192
GROQ_TEMPERATURE=0.7

# =======================================================================
# TTS (VOICE) CONFIGURATION
# =======================================================================
# Allowed values: openai, cartesia, deepgram, sarvam 
# (Defaults to openai if left blank)
TTS_PROVIDER=openai

# OpenAI TTS Overrides
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Cartesia TTS Settings
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_TTS_MODEL=sonic-english
CARTESIA_TTS_VOICE=your_cartesia_voice_id

# Deepgram TTS Settings
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Sarvam TTS Settings (Indian Languages / Specific Voices)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=hi-IN